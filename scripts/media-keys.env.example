# 창의디자인캠프 — 비상용 열쇠 (선택 사항)
#
# 평소에는 필요 없습니다. 그림·영상·음악은 전부 Higgsfield 로 만들고,
# Higgsfield 자격증명은 이미 설치본에 들어 있습니다.
#
# 이 파일은 캠프 당일 Higgsfield 가 막혔을 때를 위한 비상 경로입니다.
# 값을 채워 두면 CAMP_MEDIA_PROVIDER=cloudflare (또는 fal) 로 넘길 수 있습니다.
# 비워 두어도 캠프는 정상적으로 돌아갑니다.
#
# 값은 반드시 영문·숫자(ASCII)여야 합니다.

# 비상용 1 — Cloudflare Workers AI (FLUX.1 schnell)
#   장당 약 $0.0006. 하루 10,000 뉴런 무료.
#   ※ 한글 글자는 깨집니다. 삽화 용도로만 씁니다.
#   계정 번호: Cloudflare 대시보드 우측의 Account ID
#   열쇠: My Profile > API Tokens > Create Token ("Workers AI: Read")
CF_ACCOUNT_ID=
CF_API_TOKEN=

# 비상용 2 — fal.ai (Nano Banana 2 / MiniMax H3)
#   그림 $0.08, 영상 5초 $0.40. 종량제라 상한이 없으니
#   쓰게 된다면 대시보드에서 spending cap 을 먼저 걸어 주세요.
#   fal.ai > Dashboard > Keys
FAL_KEY=
