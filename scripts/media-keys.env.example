# 창의디자인캠프 그림·영상 만들기 열쇠.
#
# 이 파일을 dist/secrets/media-keys.env 로 복사하고 값을 채운다.
# 인스톨러가 학생 노트북의 ~/.config/camp/media-keys.env 로 넣어 준다.
# 학생은 이 값을 보지도, 입력하지도 않는다.
#
# 값은 반드시 영문·숫자(ASCII)여야 한다. 한글이나 따옴표를 넣지 않는다.

# 그림과 영상 — fal.ai  ★ 이것만 있으면 된다
#   그림: Nano Banana 2  한 장 $0.08 (대표는 2K 라 $0.12)
#   영상: MiniMax H3     5초 한 편 $0.40
#   fal.ai > Dashboard > Keys
#
#   ※ 총액 한도는 fal.ai 대시보드의 spending cap 으로 걸어 두세요.
#      횟수 제한을 두지 않았으므로 상한은 거기서만 걸 수 있습니다.
FAL_KEY=

# (선택) 비상용 — Cloudflare Workers AI (FLUX.1 schnell)
#   캠프 당일 fal 이 막혔을 때 CAMP_MEDIA_PROVIDER=cloudflare 로 넘어간다.
#   품질은 확실히 떨어지지만(글자가 깨진다) 아무것도 못 만드는 것보다는 낫다.
#   비워 둬도 캠프는 돌아간다.
#   계정 번호: Cloudflare 대시보드 우측의 Account ID
#   열쇠: My Profile > API Tokens > Create Token ("Workers AI: Read")
CF_ACCOUNT_ID=
CF_API_TOKEN=
