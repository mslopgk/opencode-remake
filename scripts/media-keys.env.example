# 창의디자인캠프 만들기 열쇠
#
# 인스톨러가 학생 노트북의 ~/.config/camp/media-keys.env 로 넣어 준다.
# 학생은 이 값을 보지도, 입력하지도 않는다.
# 값은 반드시 영문·숫자(ASCII)여야 한다.

# ── 주력: Google Gemini API ──────────────────────────────────
#   그림 gemini-3.1-flash-lite-image  1K   $0.0336
#   대표 gemini-3.1-flash-image       2K   $0.101   (한글 글자를 정확히 쓴다)
#   영상 veo-3.1-lite-generate-preview 4초 720p $0.20
#
#   aistudio.google.com/apikey 에서 발급.
#   반드시 '결제가 연결된' 프로젝트의 키여야 한다 (Free 는 한도가 낮다).
#   Tier 2(누적 $100 결제 + 3일) 이상이면 10분당 $50 까지 쓸 수 있다.
GEMINI_API_KEY=

# ── 비상용 (평소에는 비워 둔다) ──────────────────────────────
# 구글이 막혔을 때 CAMP_MEDIA_PROVIDER 로 넘긴다.
# 비워 두어도 캠프는 정상적으로 돌아간다.
CF_ACCOUNT_ID=
CF_API_TOKEN=
FAL_KEY=
